# Server Configuration
PORT=3007
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dentamate_billing
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_billing_test

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-billing-service
JWT_EXPIRES_IN=24h

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Service URLs
APPOINTMENT_SERVICE_URL=http://localhost:3003
LAB_DIAGNOSTICS_SERVICE_URL=http://localhost:3008
USER_STAFF_SERVICE_URL=http://localhost:3002
AUDIT_LOGGING_SERVICE_URL=http://localhost:3015

# File Storage
INVOICE_STORAGE_PATH=./storage/invoices
PDF_TEMPLATE_PATH=./templates

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs