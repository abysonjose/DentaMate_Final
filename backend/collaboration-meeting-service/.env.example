# Server Configuration
PORT=3012
NODE_ENV=development
SERVICE_VERSION=1.0.0

# Database Configuration
MONGODB_URI=mongodb+srv://abyjp16:abyjp16@cluster0.ozkxezh.mongodb.net/dentamate_collaboration?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://abyjp16:abyjp16@cluster0.ozkxezh.mongodb.net/dentamate_collaboration_test?retryWrites=true&w=majority

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-collaboration-service-2024
JWT_EXPIRES_IN=24h

# CORS Configuration
FRONTEND_URL=http://localhost:4200
API_GATEWAY_URL=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# Meeting Configuration
MAX_MEETING_DURATION=240
MAX_MEETING_PARTICIPANTS=10
MEETING_JOIN_WINDOW_MINUTES=15

# Notification Service Configuration
NOTIFICATION_SERVICE_URL=http://localhost:3013

# Audit Service Configuration
AUDIT_SERVICE_URL=http://localhost:3014

# WebRTC Configuration (for future video meetings)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Cache Configuration
CACHE_TTL_COLLABORATION=1800
CACHE_TTL_MEETING=1800
CACHE_TTL_DISCUSSION=600
CACHE_TTL_USER_DATA=900

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-2024

# External Service URLs
USER_STAFF_SERVICE_URL=http://localhost:3002
MEDICAL_RECORDS_SERVICE_URL=http://localhost:3003
CLINIC_BRANCH_SERVICE_URL=http://localhost:3004

# Tenant Configuration
DEFAULT_TENANT_RATE_LIMIT=500
DEFAULT_BRANCH_RATE_LIMIT=200

# Feature Flags
ENABLE_REAL_TIME_COLLABORATION=true
ENABLE_VIDEO_MEETINGS=false
ENABLE_FILE_ATTACHMENTS=true
ENABLE_MEETING_RECORDINGS=false

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9012