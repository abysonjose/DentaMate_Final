# Server Configuration
PORT=3005
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dentamate_queue
REDIS_URI=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
FRONTEND_URL=http://localhost:4200

# Logging Configuration
LOG_LEVEL=info

# Queue Configuration
TOKEN_RESET_TIME=00:00
DEFAULT_CONSULTATION_TIME=15
MAX_WAITING_TIME=180
SKIP_TIMEOUT=10
PRIORITY_TOKEN_PREFIX=P
WALKIN_TOKEN_PREFIX=W

# Service Integration URLs
APPOINTMENT_SERVICE_URL=http://localhost:8080
NOTIFICATION_SERVICE_URL=http://localhost:3006

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000