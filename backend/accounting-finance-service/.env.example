# Server Configuration
PORT=3009
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dentamate_accounting
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_accounting_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-accounting-service
JWT_EXPIRES_IN=24h

# Service URLs
API_GATEWAY_URL=http://localhost:3000
BILLING_SERVICE_URL=http://localhost:3005
INSURANCE_SERVICE_URL=http://localhost:3010
PAYROLL_SERVICE_URL=http://localhost:3011

# File Storage
UPLOAD_PATH=./storage/documents
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/accounting.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Financial Configuration
DEFAULT_CURRENCY=USD
DECIMAL_PLACES=2
FINANCIAL_YEAR_START_MONTH=4