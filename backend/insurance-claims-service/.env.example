# Server Configuration
PORT=3009
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dentamate_insurance_claims
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_insurance_claims_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-insurance-claims-service
JWT_EXPIRES_IN=24h

# File Storage Configuration
UPLOAD_PATH=./storage/documents
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# External Service URLs
BILLING_SERVICE_URL=http://localhost:3006
USER_STAFF_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3012

# Insurance Provider APIs (Example)
INSURANCE_API_TIMEOUT=30000
INSURANCE_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/insurance-claims.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:4200