# Server Configuration
PORT=3009
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dentamate_inventory
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_inventory_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-inventory-service
JWT_EXPIRES_IN=24h

# Service URLs
API_GATEWAY_URL=http://localhost:3000
BILLING_SERVICE_URL=http://localhost:3006
PRESCRIPTION_OCR_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
AUDIT_SERVICE_URL=http://localhost:3012

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX=inventory:

# Stock Alert Thresholds
LOW_STOCK_THRESHOLD=10
EXPIRY_ALERT_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/inventory.log