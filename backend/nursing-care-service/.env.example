# Server Configuration
PORT=3007
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dentamate_nursing_care
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_nursing_care_test

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# Service URLs
API_GATEWAY_URL=http://localhost:3000
APPOINTMENT_SERVICE_URL=http://localhost:3002
TOKEN_QUEUE_SERVICE_URL=http://localhost:3006

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100