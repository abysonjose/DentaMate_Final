# Environment Configuration
NODE_ENV=development
PORT=3021

# Database Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/dentamate_saas_admin?authSource=admin

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=info

# Service URLs
TENANT_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3001
API_GATEWAY_URL=http://localhost:3000

# Frontend Configuration
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,https://admin.dentamate.com

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@dentamate.com

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
PERFORMANCE_MONITORING=true

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_MAINTENANCE_MODE=false