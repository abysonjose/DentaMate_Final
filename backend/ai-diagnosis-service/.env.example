# AI Diagnosis Service Environment Configuration

# Service Configuration
DEBUG=false
PORT=8003
SERVICE_NAME=ai-diagnosis-service
VERSION=1.0.0

# Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256

# Database
MONGODB_URI=mongodb://localhost:27017/dentamate
DATABASE_NAME=dentamate

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# File Storage
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm,tiff,bmp

# AI Models
MODELS_PATH=models/
MODEL_VERSION=v1.2.0
GPU_ENABLED=false

# Processing
ASYNC_PROCESSING=true
MAX_CONCURRENT_INFERENCES=5
INFERENCE_TIMEOUT=300

# External Services
LAB_DIAGNOSTICS_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8010

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai-diagnosis.log

# XAI (Explainable AI)
GENERATE_HEATMAPS=true
HEATMAP_RESOLUTION=512

# Audit and Compliance
AUDIT_ENABLED=true
RETENTION_DAYS=2555