# Server Configuration
PORT=3007
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dentamate_lab_diagnostics
MONGODB_TEST_URI=mongodb://localhost:27017/dentamate_lab_diagnostics_test

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-lab-diagnostics
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/tiff,application/pdf,application/dicom
UPLOAD_PATH=uploads/diagnostics

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=dentamate-diagnostics

# External Services
API_GATEWAY_URL=http://localhost:3000
AI_DIAGNOSIS_SERVICE_URL=http://localhost:3008
APPOINTMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3010

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/lab-diagnostics.log