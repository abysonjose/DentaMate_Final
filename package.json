{
  "name": "dentamate",
  "version": "1.0.0",
  "description": "Comprehensive Healthcare Management System",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "docker-compose up",
    "dev:build": "docker-compose up --build",
    "stop": "docker-compose down",
    "clean": "docker-compose down -v --remove-orphans",
    "logs": "docker-compose logs -f",
    "backend:dev": "concurrently \"npm run dev --prefix backend/api-gateway\" \"npm run dev --prefix backend/auth-identity-service\"",
    "frontend:dev": "npm run start --prefix frontend",
    "test": "echo \"Run tests for individual services\"",
    "lint": "echo \"Run linting for individual services\""
  },
  "keywords": [
    "healthcare",
    "dental",
    "clinic",
    "management",
    "saas",
    "microservices",
    "angular",
    "nodejs",
    "springboot",
    "python",
    "ai"
  ],
  "author": "DentaMate Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
